{
    "name": "common-doc/commondoc",
    "description": "Multi-repository Markdown documentation site builder for PHP.",
    "license": "BSD-3-Clause",
    "keywords": [
        "commondoc",
        "documentation",
        "markdown",
        "mezzio"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "extra": {
        "laminas": {
            "config-provider": "CommonDoc\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-servicemanager": "^4.5",
        "laminas/laminas-view": "^3.1",
        "league/commonmark": "^2.10",
        "psr/container": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "symfony/console": "^7.4 || ^8.0",
        "webware/message-bus": "^2.0.0-beta.7",
        "webware/messagebus-event": "^2.0.0-beta.6",
        "webware/query-param-router": "^1.0.0-alpha.4",
        "webware/webware-console": "^1.0.0-alpha.8",
        "webware/webware-log": "^2.0.0-alpha.7",
        "webware/webware-theme": "^1.0.0-alpha.5"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.4.4",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "CommonDoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CommonDocTest\\": "test/unit/",
            "CommonDocTestIntegration\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": false
        },
        "github-protocols": [
            "https"
        ]
    },
    "bin": [
        "bin/commondoc"
    ],
    "scripts": {
        "console": "php bin/commondoc",
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": "@test && @test-integration && @mutation-test"
    }
}
