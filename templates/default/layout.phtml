 *
 * The layout shell for one document. The view renderer writes the body render
 * into `content`, so this template reads that and the navigation, and nothing
 * else: it must not assume a page, because a render performed outside a build
 * still wraps here.
 *
 * The theme is Bootstrap 5.3, which styles itself from `data-bs-theme` on the root
 * element. The first script in the head sets that attribute from the reader's saved
 * choice, or from the operating system when there is none, before the stylesheet is
 * parsed, so the page is never painted in the wrong theme. Changing it later only
 * rewrites the attribute: every colour is a CSS variable, so nothing reloads or flashes.
 *
 * The navigation is read from the routing table, which a build populates before
 * the first render. A render outside a build has no routes, so the menu is simply
 * empty. Which item is active is not decided here: a build has no request to match
 * a route against, so highlighting belongs to the browser.
 *
 * The released components are a menu in the navbar rather than a block in the sidebar,
 * because that list is identical on every page and the sidebar belongs to the page being
 * read. The item names the component the reader is in, which the browser decides from the
 * address: a static page has no request, so the same script that would highlight an item
 * reads the links the build wrote instead of repeating them.
 *
 * @var string $content
 */
?>
<?php
// The layout prepends its foundational resources, so a page that appends its own lands
// after them whichever template ran first. The icons are prepended first so Bootstrap,
// prepended last, renders ahead of them.
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headMeta()->appendName('color-scheme', 'light dark');

$this->headLink()
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css', ['media' => 'screen', 'integrity' => 'sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+', 'crossorigin' => 'anonymous'])
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', ['media' => 'screen', 'integrity' => 'sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH', 'crossorigin' => 'anonymous']);

$this->headScript()->appendScript(<<<'JS'
    (function () {
        var saved = null;
        try { saved = localStorage.getItem('commondoc-theme'); } catch (e) {}
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-bs-theme', saved || (dark ? 'dark' : 'light'));
    })();
    JS);

$this->headStyle()->appendStyle(<<<'CSS'
    .site-nav .list-group-item { padding: .3rem .5rem; }
    /* The page being read, marked by the script because a built page has no request. Its
       colour is the theme's heading colour, so the row that is current reads at the same
       weight as the title of the page it names. */
    .site-nav .list-group-item.active { background: var(--bs-tertiary-bg); color: var(--cd-heading, var(--bs-emphasis-color)); font-weight: 600; border-color: var(--bs-border-color); }
    .theme-toggle .when-dark { display: none; }
    [data-bs-theme="dark"] .theme-toggle .when-dark { display: inline; }
    [data-bs-theme="dark"] .theme-toggle .when-light { display: none; }
    .mermaid-diagram { text-align: center; margin: 1rem 0; }
    CSS);

$this->inlineScript()
    ->prependFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js', ['integrity' => 'sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz', 'crossorigin' => 'anonymous'])
    ->appendScript(<<<'JS'
        (function () {
            var box = document.querySelector('[data-search]');
            if (!box) { return; }
            var input = box.querySelector('input');
            var list = box.querySelector('[data-search-results]');
            var pages = null;
            var loading = null;

            // Ranking is the field weights title 3, heading 2 and body 1, with every term
            // required to match somewhere, and ties broken by address so the order is stable.
            function norm(value) { return String(value || '').toLowerCase(); }
            function occurrences(haystack, term) {
                var count = 0;
                var at = haystack.indexOf(term);
                while (at !== -1) { count += 1; at = haystack.indexOf(term, at + term.length); }
                return count;
            }
            function score(page, terms) {
                var title = norm(page.title);
                var text = norm(page.text);
                var headings = page.headings.map(function (h) { return norm(h.title); }).join(' ');
                var total = 0;
                for (var i = 0; i < terms.length; i += 1) {
                    var s = 3 * occurrences(title, terms[i]) + 2 * occurrences(headings, terms[i]) + occurrences(text, terms[i]);
                    if (s === 0) { return 0; }
                    total += s;
                }
                return total;
            }
            function load() {
                if (!loading) {
                    loading = fetch(box.getAttribute('data-index'))
                        .then(function (response) { return response.json(); })
                        .then(function (index) { pages = index.pages; })
                        .catch(function () { pages = []; });
                }
                return loading;
            }
            function show(results) {
                list.textContent = '';
                results.forEach(function (page) {
                    var link = document.createElement('a');
                    link.className = 'list-group-item list-group-item-action';
                    link.href = page.url;
                    link.textContent = page.title;
                    if (page.section) {
                        var small = document.createElement('small');
                        small.className = 'ms-2 text-body-secondary';
                        small.textContent = page.section;
                        link.appendChild(small);
                    }
                    list.appendChild(link);
                });
                list.hidden = results.length === 0;
            }
            function search() {
                var terms = norm(input.value).split(/\s+/).filter(Boolean);
                if (terms.length === 0 || pages === null) { show([]); return; }
                show(pages
                    .map(function (page) { return { page: page, score: score(page, terms) }; })
                    .filter(function (hit) { return hit.score > 0; })
                    .sort(function (a, b) { return b.score - a.score || (a.page.url < b.page.url ? -1 : 1); })
                    .slice(0, 8)
                    .map(function (hit) { return hit.page; }));
            }
            input.addEventListener('focus', load);
            input.addEventListener('input', function () { load().then(search); });
            input.addEventListener('keydown', function (event) { if (event.key === 'Escape') { show([]); } });
            document.addEventListener('click', function (event) { if (!box.contains(event.target)) { show([]); } });
        })();

        document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
            var root = document.documentElement;
            var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-bs-theme', next);
            try { localStorage.setItem('commondoc-theme', next); } catch (e) {}
        });

        // The components menu names the component being read rather than saying "Components"
        // on every page, and marks that item, so the reader sees where they are without
        // opening it. The label and the addresses are the ones the build wrote, so nothing
        // is spelled a second time here.
        //
        // `prefix` decides how an address is compared. A component publishes at `/name/`,
        // so the page being read is beneath it; a page's own address is the whole of it.
        function mark(selector, prefix) {
            var here = window.location.pathname;
            var found = null;
            [].slice.call(document.querySelectorAll(selector)).forEach(function (link) {
                if (found) { return; }
                var path = new URL(link.href).pathname;
                if (prefix ? 0 === here.indexOf(path) : here === path) {
                    link.classList.add('active');
                    link.setAttribute('aria-current', 'page');
                    found = link;
                }
            });
            return found;
        }

        (function () {
            var box = document.querySelector('[data-dropdown="components"]');
            var current = mark('[data-dropdown-menu="components"] a.dropdown-item', true);
            if (box && current) {
                box.querySelector('[data-dropdown-toggle="components"]').textContent = current.textContent;
            }
            mark('.site-nav a.list-group-item', false);
        })();
        JS);
?>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <?= $this->headMeta() ?>
    <?= $this->headScript() ?>
    <?php $project = $this->projectName(); ?>
    <?= $this->headTitle('' === $project ? null : $project)->setSeparator(' | ') ?>
    <?= $this->headLink() ?>
    <?= $this->headStyle() ?>
    <style><?= $this->partial('commondoc::theme') ?></style>
</head>
<body>
    <nav class="navbar border-bottom bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="<?= $this->escapeHtmlAttr($this->basePath('/')) ?>">Documentation</a>
            <?= $this->componentMenu() ?>
            <?= $this->versionSwitch() ?>
            <div class="position-relative flex-grow-1 mx-3" style="max-width: 32rem" data-search data-index="<?= $this->escapeHtmlAttr($this->basePath('search-index.json')) ?>">
                <input type="search" class="form-control form-control-sm" placeholder="Search the documentation" aria-label="Search the documentation" autocomplete="off">
                <div class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1050" data-search-results hidden></div>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
                <i class="bi bi-moon-stars-fill when-light" aria-hidden="true"></i>
                <i class="bi bi-sun-fill when-dark" aria-hidden="true"></i>
            </button>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <?php $menu = $this->pageMenu(); ?>
            <?php if ('' !== $menu) : ?>
                <nav class="site-nav col-md-3 col-xl-2 py-3">
                    <?= $menu ?>
                </nav>
            <?php endif ?>
            <div class="<?= '' === $menu ? 'col-12' : 'col-md-9 col-xl-10' ?> py-3 px-md-4">
                <?= $this->content ?>
            </div>
        </div>
    </div>
    <?= $this->inlineScript() ?>
</body>
</html>
