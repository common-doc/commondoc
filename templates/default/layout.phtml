 *
 * The layout shell for one document. The view renderer writes the body render
 * into `content`, so this template reads that and the navigation, and nothing
 * else: it must not assume a page, because a render performed outside a build
 * still wraps here.
 *
 * The theme is Bootstrap 5.3, which styles itself from `data-bs-theme` on the root
 * element. The first script in the head sets that attribute from the reader's saved
 * choice, or from the operating system when there is none, before the stylesheet is
 * parsed, so the page is never painted in the wrong theme. Changing it later only
 * rewrites the attribute: every colour is a CSS variable, so nothing reloads or flashes.
 *
 * The navigation is read from the routing table, which a build populates before
 * the first render. A render outside a build has no routes, so the menu is simply
 * empty. Which item is active is not decided here: a build has no request to match
 * a route against, so highlighting belongs to the browser.
 *
 * @var string $content
 */
?>
<?php
// The layout prepends its foundational resources, so a page that appends its own lands
// after them whichever template ran first. The icons are prepended first so Bootstrap,
// prepended last, renders ahead of them.
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headMeta()->appendName('color-scheme', 'light dark');

$this->headLink()
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css', ['media' => 'screen', 'integrity' => 'sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+', 'crossorigin' => 'anonymous'])
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', ['media' => 'screen', 'integrity' => 'sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH', 'crossorigin' => 'anonymous']);

$this->headScript()->appendScript(<<<'JS'
    (function () {
        var saved = null;
        try { saved = localStorage.getItem('commondoc-theme'); } catch (e) {}
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-bs-theme', saved || (dark ? 'dark' : 'light'));
    })();
    JS);

$this->headStyle()->appendStyle(<<<'CSS'
    .site-nav .nav-link { padding: .25rem .5rem; border-radius: var(--bs-border-radius); }
    .site-nav .nav-link:hover { background: var(--bs-tertiary-bg); }
    .theme-toggle .when-dark { display: none; }
    [data-bs-theme="dark"] .theme-toggle .when-dark { display: inline; }
    [data-bs-theme="dark"] .theme-toggle .when-light { display: none; }
    .document img { max-width: 100%; height: auto; }
    .document pre { padding: 1rem; border-radius: var(--bs-border-radius); background: var(--bs-tertiary-bg); }
    .document table { width: 100%; margin-bottom: 1rem; }
    .document th, .document td { padding: .375rem .75rem; border: 1px solid var(--bs-border-color); }
    /* An admonition is an alert with a title. Each type picks one alert colour, and
       `important` borrows Bootstrap's purple, which no alert variant provides. */
    .admonition > :last-child { margin-bottom: 0; }
    .admonition-title { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; font-weight: 600; }
    .admonition-important {
        --bs-alert-color: var(--bs-purple-text-emphasis, #3d1a6e);
        --bs-alert-bg: var(--bs-purple-bg-subtle, #e2d9f3);
        --bs-alert-border-color: var(--bs-purple-border-subtle, #c5b3e6);
    }
    [data-bs-theme="dark"] .admonition-important {
        --bs-alert-color: #d3b8f0;
        --bs-alert-bg: #2a1a40;
        --bs-alert-border-color: #4a2f73;
    }
    CSS);

$this->inlineScript()
    ->prependFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js', ['integrity' => 'sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz', 'crossorigin' => 'anonymous'])
    ->appendScript(<<<'JS'
        document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
            var root = document.documentElement;
            var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-bs-theme', next);
            try { localStorage.setItem('commondoc-theme', next); } catch (e) {}
        });
        JS);
?>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <?= $this->headMeta() ?>
    <?= $this->headScript() ?>
    <?= $this->headTitle()->setSeparator(' | ') ?>
    <?= $this->headLink() ?>
    <?= $this->headStyle() ?>
</head>
<body>
    <nav class="navbar border-bottom bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="<?= $this->escapeHtmlAttr($this->basePath('/')) ?>">Documentation</a>
            <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
                <i class="bi bi-moon-stars-fill when-light" aria-hidden="true"></i>
                <i class="bi bi-sun-fill when-dark" aria-hidden="true"></i>
            </button>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <nav class="site-nav col-md-3 col-xl-2 py-3 border-end">
                <?php $components = $this->navigation(\CommonDoc\Output\RouteRegistrar::COMPONENTS); ?>
                <?php if ([] !== $components->getItems()) : ?>
                    <h2 class="h6 text-uppercase text-body-secondary px-2">Components</h2>
                    <?= $components->menu() ?>
                    <hr>
                <?php endif ?>
                <h2 class="h6 text-uppercase text-body-secondary px-2">Pages</h2>
                <?= $this->navigation((string) $this->placeholder('commondoc.scope'))->menu() ?>
            </nav>
            <div class="col-md-9 col-xl-10 py-3 px-md-4">
                <?= $this->content ?>
            </div>
        </div>
    </div>
    <?= $this->inlineScript() ?>
</body>
</html>
